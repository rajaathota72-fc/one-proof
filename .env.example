# Reverse image search
SERPAPI_KEY=

# Optional override for Google Lens.
IMAGE_PUBLIC_URL=

# Private S3 bucket used for temporary image uploads. OneProof generates a
# 10-minute pre-signed URL, so the bucket does not need public-read access.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=oneproof
S3_PREFIX=oneproof/uploads

# Sepolia blockchain
# Example: https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=

# Funded signer wallet private key. Never commit a real value.
PRIVATE_KEY=

# Deployed ProofOfHuman contract address on Sepolia.
CONTRACT_ADDRESS=
