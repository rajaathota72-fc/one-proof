# Reverse image search
SERPAPI_KEY=

# Public URL of the uploaded image used by Google Lens.
# For Heroku, use your deployed app URL or an external upload host.
IMAGE_PUBLIC_URL=

# Sepolia blockchain
# Example: https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=

# Funded signer wallet private key. Never commit a real value.
PRIVATE_KEY=

# Deployed ProofOfHuman contract address on Sepolia.
CONTRACT_ADDRESS=
